[Unit]
Description=FieldBox touchscreen UI (FastAPI backend)
After=network.target tailscaled.service
Wants=tailscaled.service

[Service]
Type=simple
WorkingDirectory=/opt/fieldbox/src
ExecStart=/opt/fieldbox/.venv/bin/uvicorn fieldbox_ui.app:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
